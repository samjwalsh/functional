THEORY Ex4Q4
IMPORT-THEORY Equality
IMPORT-THEORY Boolean
IMPORT-THEORY Arithmetic
IMPORT-THEORY List
IMPORT-HASKELL List
IMPORT-HASKELL Ex4

THEOREM ex4q4

   d3oubling (x+1) > d3oubling x

STRATEGY CaseSplit Plus1Order

CASE 1 (x < 4)
SHOW
   d3oubling (x+1) > d3oubling x

   STRATEGY ReduceAll

   d3oubling (x+1) > d3oubling x
   = DEF d3oubling
   (if (x + 1) < 5 then 2 * (x + 1) else 2 * (x + 1) - 1) > d3oubling x
   = SIMP
   2 * (x + 1) > d3oubling x
   = DEF d3oubling
   2 * (x + 1) > (if x < 5 then 2 * x else 2 * x - 1)
   = SIMP
   2 * (x + 1) > 2 * x
   = SIMP
   True

   END ReduceAll

END CASE 1

CASE 2 (x == 4)
SHOW
   d3oubling (x+1) > d3oubling x

   STRATEGY ReduceAll

   d3oubling (x+1) > d3oubling x
   = DEF d3oubling
   (if (x + 1) < 5 then 2 * (x + 1) else 2 * (x + 1) - 1) > d3oubling x
   = SIMP
   (2 * (x + 1) - 1) > d3oubling x
   = DEF d3oubling
   (2 * (x + 1) - 1) > (if x < 5 then 2 * x else 2 * x - 1)
   = SIMP
   (2 * (x + 1) - 1) > 2 * x
   = SIMP
   True

   END ReduceAll

END CASE 2

CASE 3 (x == 5)
SHOW
   d3oubling (x+1) > d3oubling x

   STRATEGY ReduceAll

   d3oubling (x+1) > d3oubling x
   = DEF d3oubling
   (if (x + 1) < 5 then 2 * (x + 1) else 2 * (x + 1) - 1) > d3oubling x
   = SIMP
   (2 * (x + 1) - 1) > d3oubling x
   = DEF d3oubling
   (2 * (x + 1) - 1) > (if x < 5 then 2 * x else 2 * x - 1)
   = SIMP
   (2 * (x + 1) - 1) > (2 * x - 1)
   = SIMP
   True

   END ReduceAll

END CASE 3

CASE 4 (x > 5)
SHOW
   d3oubling (x+1) > d3oubling x

   STRATEGY ReduceAll

   d3oubling (x+1) > d3oubling x
   = DEF d3oubling
   (if (x + 1) < 5 then 2 * (x + 1) else 2 * (x + 1) - 1) > d3oubling x
   = SIMP
   (2 * (x + 1) - 1) > d3oubling x
   = DEF d3oubling
   (2 * (x + 1) - 1) > (if x < 5 then 2 * x else 2 * x - 1)
   = SIMP
   (2 * (x + 1) - 1) > (2 * x - 1)
   = SIMP
   True

   END ReduceAll

END CASE 4

END CaseSplit

QED ex4q4

CASE-SCHEME Plus1Order
CASE 1  (x <  4)
CASE 2  (x == 4)
CASE 3  (x == 5)
CASE 4  (x >  5)
EXHAUSTIVE (x <  4) || (x == 4) || (x == 5) || (x >  5)
EXCLUSIVE 1 2  not((x <  4) && (x == 4))
EXCLUSIVE 1 3  not((x <  4) && (x == 5))
EXCLUSIVE 1 4  not((x <  4) && (x >  5))
EXCLUSIVE 2 3  not((x == 4) && (x == 5))
EXCLUSIVE 2 4  not((x == 4) && (x >  5))
EXCLUSIVE 3 4  not((x == 5) && (x >  5))
