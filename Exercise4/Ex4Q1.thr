THEORY Ex4Q1
IMPORT-THEORY Equality
IMPORT-THEORY Boolean
IMPORT-THEORY Arithmetic
IMPORT-THEORY List
IMPORT-HASKELL List
IMPORT-HASKELL Ex4

THEOREM ex4q1

   ((x - (y - z)) * 1) - (0 + 0) == (((z + x) - y) * 1) + (0 - 0)

STRATEGY ReduceAll

   ((x - (y - z)) * 1) - (0 + 0) == (((z + x) - y) * 1) + (0 - 0)
   = LAW mul_right_unit l2r @ * 1
   ((x - (y - z)) - (0 + 0)) == (((z + x) - y) * 1) + (0 - 0)
   = LAW add_left_unit l2r @ + 1
   ((x - (y - z)) - 0) == (((z + x) - y) * 1) + (0 - 0)
   = LAW sub_right_unit l2r @ - 3
   (x - (y - z)) == (((z + x) - y) * 1) + (0 - 0)
   = LAW mul_right_unit l2r @ * 1
   (x - (y - z)) == (((z + x) - y) + (0 - 0))
   = LAW sub_zero l2r @ - 4
   (x - (y - z)) == (((z + x) - y) + 0)
   = LAW add_right_unit l2r @ + 2
   (x - (y - z)) == ((z + x) - y)
   = LAW add_sub_assoc2 r2l @ - 1
   ((x + z) - y) == ((z + x) - y)
   = LAW add_symm l2r @ + 1
   ((z + x) - y) == ((z + x) - y)
   = LAW eq_refl
   True

END ReduceAll

QED ex4q1

